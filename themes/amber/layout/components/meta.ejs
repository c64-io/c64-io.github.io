<div class="post-meta">
  <time datetime="<%= item.date.toDate().toISOString() %>"><%= item.date.format(config.date_format) %></time>
  <% if (item.categories && item.categories.length){ %>
    <span class="sep">/</span>
    <span class="cats"><% item.categories.forEach(function(cat, i){ %><a href="<%- url_for(cat.path) %>"><%= cat.name %></a><%= i < item.categories.length - 1 ? ', ' : '' %><% }); %></span>
  <% } %>
  <% if (item.tags && item.tags.length){ %>
    <span class="sep">/</span>
    <span class="tags"><% item.tags.forEach(function(tag){ %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% }); %></span>
  <% } %>
</div>
